# Copy to .env (git-ignored) and fill in. Load with: source .env
# The ES_* names match the ones Phase 2 uses.
export ES_URL="https://elktest-node1.example.internal:9200"
export ES_ADMIN_USER="elastic"
export ES_ADMIN_PW='change-me'
export ES_CA_CERT="$HOME/certs/elktest-ca.crt"
export ES_CURL_OPTS="--cacert $ES_CA_CERT"
# API keys: paste the "encoded" value between the quotes once you create each key.
export ES_API_KEY=''         # Phase 2 Step 5: read-only key llm-obs-rag-lambda (search)
export ES_WRITER_API_KEY=''  # Phase 4 Step 4.6: write-only key llm-obs-lambda-writer (prompt logs, Guardrail events)
export CORPUS_BUCKET="llm-obs-corpus-123456789012"
export API_URL="https://abc123defg.execute-api.us-east-1.amazonaws.com"
